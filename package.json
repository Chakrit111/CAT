{
  "name": "desktop-pet",
  "version": "0.1.0",
  "private": true,
  "description": "Transparent always-on-top desktop pet (Electron + TypeScript)",
  "main": "dist/main.js",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "node build.mjs",
    "start": "npm run build && electron .",
    "shortcut": "npm run build && node scripts/shortcut.mjs",
    "dist": "node scripts/build-pet.mjs donut-cat",
    "build-pet": "node scripts/build-pet.mjs",
    "publish-pet": "node scripts/publish-pet.mjs",
    "new-pet": "node scripts/new-pet.mjs",
    "check-pet": "node scripts/check-pet.mjs",
    "import-sprites": "python -I scripts/fit_frames.py",
    "preview": "python -I scripts/contact_sheet.py"
  },
  "build": {
    "files": [
      "dist/**/*",
      "!dist/**/*.map",
      "package.json",
      "!node_modules/onnxruntime-web/**",
      "!node_modules/onnxruntime-node/bin/*/darwin/**",
      "!node_modules/onnxruntime-node/bin/*/linux/**",
      "!node_modules/onnxruntime-node/bin/*/win32/arm64/**"
    ],
    "asarUnpack": [
      "node_modules/onnxruntime-node/**",
      "node_modules/sharp/**",
      "node_modules/@img/**"
    ],
    "win": {
      "target": "portable"
    }
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@huggingface/transformers": "4.3.2"
  }
}
